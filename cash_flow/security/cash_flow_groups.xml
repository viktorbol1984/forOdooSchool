<odoo>
    <record id="module_category_cash_flow" model="ir.module.category">
        <field name="name">Cash Flow</field>
        <field name="description">Access levels for Cash Flow</field>
        <field name="sequence">30</field>
    </record>

    <record id="res_groups_privilege_cash_flow" model="res.groups.privilege">
        <field name="name">Cash Flow</field>
        <field name="category_id" ref="cash_flow.module_category_cash_flow"/>
    </record>

    <record id="group_cash_flow_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="cash_flow.res_groups_privilege_cash_flow"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_cash_flow_administrator" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="cash_flow.res_groups_privilege_cash_flow"/>
        <field name="implied_ids" eval="[(4, ref('cash_flow.group_cash_flow_user'))]"/>
    </record>
</odoo>
