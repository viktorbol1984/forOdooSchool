<odoo>
    <data>
        <record id="view_partner_form_inherit_cash_flow_dds" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.cash.flow.dds</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='category_id']" position="after">
                    <field name="default_dds_article_id"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
