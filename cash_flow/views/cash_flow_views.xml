<odoo>
    <data>
        <record id="view_cash_flow_cashbox_list" model="ir.ui.view">
            <field name="name">cash.flow.cashbox.list</field>
            <field name="model">cash.flow.cashbox</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="city_id"/>
                    <field name="cashier_user_id"/>
                    <field name="currency_id"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_cash_flow_cashbox_form" model="ir.ui.view">
            <field name="name">cash.flow.cashbox.form</field>
            <field name="model">cash.flow.cashbox</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="city_id"/>
                            <field name="cashier_user_id"/>
                            <field name="currency_id"/>
                            <field name="active"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_cash_flow_transaction_list" model="ir.ui.view">
            <field name="name">cash.flow.transaction.list</field>
            <field name="model">cash.flow.transaction</field>
            <field name="arch" type="xml">
                <list>
                    <field name="date"/>
                    <field name="is_planned"/>
                    <field name="name"/>
                    <field name="cashbox_id"/>
                    <field name="transfer_id"/>
                    <field name="partner_id"/>
                    <field name="article_id"/>
                    <field name="transaction_type"/>
                    <field name="amount"/>
                </list>
            </field>
        </record>

        <record id="view_cash_flow_transaction_form" model="ir.ui.view">
            <field name="name">cash.flow.transaction.form</field>
            <field name="model">cash.flow.transaction</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="is_planned"/>
                            <field name="cashbox_id"/>
                            <field name="transfer_id"/>
                            <field name="partner_id"/>
                            <field name="article_id"/>
                            <field name="transaction_type"/>
                            <field name="amount"/>
                            <field name="note"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_cash_flow_dds_article_list" model="ir.ui.view">
            <field name="name">cash.flow.dds.article.list</field>
            <field name="model">cash.flow.dds.article</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="category_id"/>
                    <field name="transaction_type"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_cash_flow_dds_article_form" model="ir.ui.view">
            <field name="name">cash.flow.dds.article.form</field>
            <field name="model">cash.flow.dds.article</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="category_id"/>
                            <field name="transaction_type"/>
                            <field name="active"/>
                            <field name="note"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_cash_flow_dds_category_list" model="ir.ui.view">
            <field name="name">cash.flow.dds.category.list</field>
            <field name="model">cash.flow.dds.category</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="parent_id"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_cash_flow_dds_category_form" model="ir.ui.view">
            <field name="name">cash.flow.dds.category.form</field>
            <field name="model">cash.flow.dds.category</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="parent_id"/>
                            <field name="active"/>
                        </group>
                        <notebook>
                            <page string="Children">
                                <field name="child_ids">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="active"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_cash_flow_transfer_list" model="ir.ui.view">
            <field name="name">cash.flow.transfer.list</field>
            <field name="model">cash.flow.transfer</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="date"/>
                    <field name="source_cashbox_id"/>
                    <field name="destination_cashbox_id"/>
                    <field name="amount"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="view_cash_flow_transfer_form" model="ir.ui.view">
            <field name="name">cash.flow.transfer.form</field>
            <field name="model">cash.flow.transfer</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_post" type="object" string="Post" class="btn-primary" invisible="state != 'draft'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="date"/>
                            <field name="source_cashbox_id"/>
                            <field name="destination_cashbox_id"/>
                            <field name="amount"/>
                            <field name="note"/>
                        </group>
                        <group string="Posted Transactions" invisible="state != 'posted'">
                            <field name="expense_transaction_id" readonly="1"/>
                            <field name="income_transaction_id" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_cash_flow_cashbox" model="ir.actions.act_window">
            <field name="name">Cashboxes</field>
            <field name="res_model">cash.flow.cashbox</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_cash_flow_transaction" model="ir.actions.act_window">
            <field name="name">Transactions</field>
            <field name="res_model">cash.flow.transaction</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_cash_flow_dds_article" model="ir.actions.act_window">
            <field name="name">DDS Articles</field>
            <field name="res_model">cash.flow.dds.article</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_cash_flow_dds_category" model="ir.actions.act_window">
            <field name="name">DDS Categories</field>
            <field name="res_model">cash.flow.dds.category</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_cash_flow_transfer" model="ir.actions.act_window">
            <field name="name">Transfers</field>
            <field name="res_model">cash.flow.transfer</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_cash_flow_root" name="Cash Flow" sequence="10"/>
        <menuitem id="menu_cash_flow_cashboxes" name="Cashboxes" parent="menu_cash_flow_root" action="action_cash_flow_cashbox" sequence="10"/>
        <menuitem id="menu_cash_flow_transfers" name="Transfers" parent="menu_cash_flow_root" action="action_cash_flow_transfer" sequence="12"/>
        <menuitem id="menu_cash_flow_dds_categories" name="DDS Categories" parent="menu_cash_flow_root" action="action_cash_flow_dds_category" sequence="15"/>
        <menuitem id="menu_cash_flow_dds_articles" name="DDS Articles" parent="menu_cash_flow_root" action="action_cash_flow_dds_article" sequence="20"/>
        <menuitem id="menu_cash_flow_transactions" name="Transactions" parent="menu_cash_flow_root" action="action_cash_flow_transaction" sequence="30"/>
    </data>
</odoo>
