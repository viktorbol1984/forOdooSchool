<odoo>
    <data>
        <record id="view_cash_flow_transaction_list" model="ir.ui.view">
            <field name="name">cash.flow.transaction.list</field>
            <field name="model">cash.flow.transaction</field>
            <field name="arch" type="xml">
                <list>
                    <field name="date"/>
                    <field name="is_planned"/>
                    <field name="name"/>
                    <field name="cashbox_id"/>
                    <field name="transfer_id"/>
                    <field name="partner_id"/>
                    <field name="article_id"/>
                    <field name="transaction_type"/>
                    <field name="amount"/>
                </list>
            </field>
        </record>

        <record id="view_cash_flow_transaction_form" model="ir.ui.view">
            <field name="name">cash.flow.transaction.form</field>
            <field name="model">cash.flow.transaction</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="is_planned"/>
                            <field name="cashbox_id"/>
                            <field name="transfer_id"/>
                            <field name="partner_id"/>
                            <field name="article_id"/>
                            <field name="transaction_type"/>
                            <field name="amount"/>
                            <field name="note"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_cash_flow_transaction_graph" model="ir.ui.view">
            <field name="name">cash.flow.transaction.graph</field>
            <field name="model">cash.flow.transaction</field>
            <field name="arch" type="xml">
                <graph string="Transactions" type="bar">
                    <field name="date" type="row"/>
                    <field name="amount" type="measure"/>
                </graph>
            </field>
        </record>

        <record id="view_cash_flow_transaction_kanban" model="ir.ui.view">
            <field name="name">cash.flow.transaction.kanban</field>
            <field name="model">cash.flow.transaction</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_small_column" default_group_by="cashbox_id">
                    <progressbar
                        field="transaction_type"
                        colors='{"income":"success","expense":"danger"}'
                        sum_field="amount"
                    />
                    <field name="name"/>
                    <field name="date"/>
                    <field name="cashbox_id"/>
                    <field name="partner_id"/>
                    <field name="article_id"/>
                    <field name="transaction_type"/>
                    <field name="amount" sum="Total Amount"/>
                    <field name="is_planned"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card">
                                <div><strong><field name="name"/></strong></div>
                                <div><field name="date"/></div>
                                <div><field name="cashbox_id"/></div>
                                <div><field name="partner_id"/></div>
                                <div><field name="article_id"/></div>
                                <div><field name="transaction_type"/></div>
                                <div><field name="amount"/></div>
                                <div><field name="is_planned"/></div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="action_cash_flow_transaction" model="ir.actions.act_window">
            <field name="name">Transactions</field>
            <field name="res_model">cash.flow.transaction</field>
            <field name="view_mode">list,form,graph,kanban</field>
        </record>
    </data>
</odoo>
