<odoo>
    <data>
        <record id="view_cash_flow_dds_category_list" model="ir.ui.view">
            <field name="name">cash.flow.dds.category.list</field>
            <field name="model">cash.flow.dds.category</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="parent_id"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_cash_flow_dds_category_form" model="ir.ui.view">
            <field name="name">cash.flow.dds.category.form</field>
            <field name="model">cash.flow.dds.category</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="parent_id"/>
                            <field name="active"/>
                        </group>
                        <notebook>
                            <page string="Children">
                                <field name="child_ids">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="active"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_cash_flow_dds_category" model="ir.actions.act_window">
            <field name="name">DDS Categories</field>
            <field name="res_model">cash.flow.dds.category</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
