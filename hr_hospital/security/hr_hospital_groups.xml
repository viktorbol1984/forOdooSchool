<odoo>
    <data noupdate="1">
        <record id="module_category_hr_hospital" model="ir.module.category">
            <field name="name">HR Hospital</field>
            <field name="description">Access levels for HR Hospital module</field>
            <field name="sequence">30</field>
        </record>

        <record id="res_groups_privilege_hr_hospital" model="res.groups.privilege">
            <field name="name">HR Hospital</field>
            <field name="category_id" ref="hr_hospital.module_category_hr_hospital"/>
        </record>

        <record id="group_hr_hospital_patient" model="res.groups">
            <field name="name">HR_Patient</field>
            <field name="privilege_id" ref="hr_hospital.res_groups_privilege_hr_hospital"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_hr_hospital_intern" model="res.groups">
            <field name="name">HR_Intern</field>
            <field name="privilege_id" ref="hr_hospital.res_groups_privilege_hr_hospital"/>
            <field name="implied_ids" eval="[(4, ref('hr_hospital.group_hr_hospital_patient'))]"/>
        </record>

        <record id="group_hr_hospital_doctor" model="res.groups">
            <field name="name">HR_Doctor</field>
            <field name="privilege_id" ref="hr_hospital.res_groups_privilege_hr_hospital"/>
            <field name="implied_ids" eval="[(4, ref('hr_hospital.group_hr_hospital_intern'))]"/>
        </record>

        <record id="group_hr_hospital_manager" model="res.groups">
            <field name="name">HR_Manager</field>
            <field name="privilege_id" ref="hr_hospital.res_groups_privilege_hr_hospital"/>
            <field name="implied_ids" eval="[(4, ref('hr_hospital.group_hr_hospital_doctor'))]"/>
        </record>

        <record id="group_hr_hospital_administrator" model="res.groups">
            <field name="name">HR_Administrator</field>
            <field name="privilege_id" ref="hr_hospital.res_groups_privilege_hr_hospital"/>
            <field name="implied_ids" eval="[(4, ref('hr_hospital.group_hr_hospital_manager'))]"/>
        </record>
    </data>
</odoo>
