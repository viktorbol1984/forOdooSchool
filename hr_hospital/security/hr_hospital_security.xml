<odoo>
    <data noupdate="1">
        <record id="hr_hospital_rule_visits_patient" model="ir.rule">
            <field name="name">Patient sees own</field>
            <field name="model_id" ref="model_hr_hospital_visits"/>
            <field name="groups" eval="[(4, ref('hr_hospital.group_hr_hospital_patient'))]"/>
            <field name="domain_force">[('patient_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rhr_hospital_rule_visits_intern" model="ir.rule">
            <field name="name">Intern sees own</field>
            <field name="model_id" ref="model_hr_hospital_visits"/>
            <field name="groups" eval="[(4, ref('hr_hospital.group_hr_hospital_intern'))]"/>
            <field name="domain_force">[('doctor_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rhr_hospital_rule_visits_doctor" model="ir.rule">
            <field name="name">Doctor sees own and interns</field>
            <field name="model_id" ref="model_hr_hospital_visits"/>
            <field name="groups" eval="[(4, ref('hr_hospital.group_hr_hospital_doctor'))]"/>
            <field name="domain_force">['|', ('doctor_id.user_id', '=', user.id), ('doctor_id.mentor_doctor_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rhr_hospital_rule_visits_manager" model="ir.rule">
            <field name="name">Manager sees all</field>
            <field name="model_id" ref="model_hr_hospital_visits"/>
            <field name="groups" eval="[(4, ref('hr_hospital.group_hr_hospital_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rhr_hospital_rule_visits_administrator" model="ir.rule">
            <field name="name">Administrator sees all</field>
            <field name="model_id" ref="model_hr_hospital_visits"/>
            <field name="groups" eval="[(4, ref('hr_hospital.group_hr_hospital_administrator'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>
